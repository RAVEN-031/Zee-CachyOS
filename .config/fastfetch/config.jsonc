
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": 
  {
	"type" : "kitty-direct",
    "source" : "~/ASCII_Arts/zee-bow.png",
	"padding" : { "top" : 3}
  },
  "display": {"separator": " "},
  "modules": 
  [
    {
      "type": "title",
      "keywidth": 8
    },
    {
      "type": "custom",
      "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"},
    {
      "type": "os",
      "key": "╭ ",
      "keyColor": "#FF0909"
    },
    {
      "type": "kernel",
      "key": "├ ",
      "keyColor": "#FF0909"
    },
    {
      "type": "packages",
      "key": "├󰏖 ",
      "keyColor": "#FF0909"
    },
    {
      "type": "command",
      "key": "╰ ",
      "keyColor": "#FF0909",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    "break",
    {
      "type": "wm",
      "key": "╭ ",
      "keyColor": "#DC5F00"
    },
    // {
    //  "type": "wmtheme",
    //  "key": "├󰉼 ",
    //  "keyColor": "#DC5F00"
    // },
    //{
    //  "type": "icons",
    //  "key": "├󰀻 ",
    //  "keyColor": "#DC5F00"
    //},
    //{
    //  "type": "cursor",
    //  "key": "╰ ",
    //  "keyColor": "#DC5F00"
    //},
    //"break",
    {
      "type": "terminal",
      "key": "├ ",
      "keyColor": "#DC5F00"
    },
    {
      "type": "shell",
      "key": "├ ",
      "keyColor": "#DC5F00"
    },
    {
      "type": "terminalFont",
      "key": "╰ ",
      "keyColor": "#DC5F00" 
    },
    "break",
    {
      "type": "host",
      "key": "╭ ",
      "keyColor": "#007DDC"
    },
    {
      "type": "cpu",
      "key": "├ ",
      "keyColor": "#007DDC"
    },
    {
      "type": "gpu",
      "key": "├ ",
      "format": "{2}",
      "keyColor": "#007DDC"
    },
    {
      "type": "display",
      "key": "├󰍹 ",
      "keyColor": "#007DDC",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "memory",
      "key": "├ ",
      "keyColor": "#007DDC",
      "percent": 
        {
          "type": 3
        }
    },
    {
      "type": "disk",
      "key": "├ ",
      "keyColor": "#007DDC",
      "percent": 
        {
          "type": 3
        }
    },
    {
      "type": "uptime",
      "key": "╰󰅐 ",
      "keyColor": "#007DDC"
    },
    "break",
